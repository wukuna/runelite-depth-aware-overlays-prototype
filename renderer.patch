+import java.nio.ByteBuffer;
+import org.lwjgl.BufferUtils;
+import static org.lwjgl.opengl.GL33C.*;
+
+/** Separate depth attachment; shares scene color only for the final label composition. */
+final class SelectiveDepth
+{
+    static final SelectiveDepth INSTANCE = new SelectiveDepth();
+    private int fbo, depth, color, width, height, samples;
+    boolean active;
+    private int sceneFramebuffer, sceneDepthUniform;
+    private final ByteBuffer colorMask = BufferUtils.createByteBuffer(4);
