+    {
+        active = false;
+        if (!enabled) { return; }
+        int previous = glGetInteger(GL_DRAW_FRAMEBUFFER_BINDING);
+        sceneFramebuffer = previous;
+        int sceneProgram = glGetInteger(GL_CURRENT_PROGRAM);
+        sceneDepthUniform = sceneProgram == 0 ? -1 : glGetUniformLocation(sceneProgram, "testLabelDepth");
