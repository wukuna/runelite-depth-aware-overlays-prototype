+    // Core-renderer-only path. Caller guarantees the scene program, GREATER depth
+    // test and full color mask; depthWrite is the original pass's write setting.
+    // This avoids synchronous driver queries for every replayed geometry batch.
+    void replayScene(Runnable draw, boolean depthWrite)
+    {
+        if (!active) { return; }
