+            int w = glGetRenderbufferParameteri(GL_RENDERBUFFER, GL_RENDERBUFFER_WIDTH);
+            int h = glGetRenderbufferParameteri(GL_RENDERBUFFER, GL_RENDERBUFFER_HEIGHT);
+            int ms = glGetRenderbufferParameteri(GL_RENDERBUFFER, GL_RENDERBUFFER_SAMPLES);
+            if (fbo == 0 || color != attachment || width != w || height != h || samples != ms)
+            {
+                close();
+                fbo = glGenFramebuffers(); depth = glGenRenderbuffers();
+                color = attachment; width = w; height = h; samples = ms;
+                glBindRenderbuffer(GL_RENDERBUFFER, depth);
+                if (ms > 0) { glRenderbufferStorageMultisample(GL_RENDERBUFFER, ms, GL_DEPTH_COMPONENT32F, w, h); }
+                else { glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT32F, w, h); }
+                glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo);
+                glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, color);
+                glFramebufferRenderbuffer(GL_DRAW_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, depth);
+                if (glCheckFramebufferStatus(GL_DRAW_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE)
+                { throw new IllegalStateException("Incomplete TEST selective-depth framebuffer"); }
+            }
