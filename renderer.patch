+package net.runelite.client.plugins.gpu;
+
+/** Bounded placement based only on ground immediately around the item, never scene occluders. */
+final class GroundClearance
+{
+    static final float MAX_LIFT = 64;
+
+    static float lift(float[] matrix, float x, float y, float z, float[] ground,
+                      int viewportHeight, int labelHeight)
+    {
+        if (ground == null || viewportHeight <= 0) { return 0; }
+        float baseline = screenY(matrix, x, y, z, viewportHeight);
+        if (!Float.isFinite(baseline)) { return 0; }
+        float limit = Float.POSITIVE_INFINITY;
+        for (int i = 0; i + 2 < ground.length; i += 3)
+        {
+            float pixel = screenY(matrix, ground[i], ground[i+1], ground[i+2], viewportHeight);
+            if (Float.isFinite(pixel)) { limit = Math.min(limit, pixel); }
+        }
+        if (!Float.isFinite(limit)) { return 0; }
+        float target = limit - labelHeight * .5f - 2;
