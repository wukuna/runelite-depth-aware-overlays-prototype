+        }
+    }
+
+    void labels(Runnable draw)
+    {
+        if (!active) { return; }
+        int previous = glGetInteger(GL_DRAW_FRAMEBUFFER_BINDING);
+        try { glBindFramebuffer(GL_DRAW_FRAMEBUFFER, fbo); draw.run(); }
+        finally { glBindFramebuffer(GL_DRAW_FRAMEBUFFER, previous); active = false; }
+    }
+
+    void close()
+    {
+        active = false;
+        if (fbo != 0) { glDeleteFramebuffers(fbo); fbo = 0; }
+        if (depth != 0) { glDeleteRenderbuffers(depth); depth = 0; }
+        color = 0;
+    }
+}
