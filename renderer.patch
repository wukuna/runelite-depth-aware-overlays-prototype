+package net.runelite.client.plugins.gpu;
+
+import java.awt.Color;
+import java.awt.Font;
+import java.awt.Graphics2D;
+import java.awt.image.BufferedImage;
+import java.nio.ByteBuffer;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import net.runelite.api.Client;
+import net.runelite.api.GameState;
+import net.runelite.api.Perspective;
+import net.runelite.api.Tile;
+import net.runelite.api.TileItem;
+import net.runelite.api.WorldView;
+import net.runelite.api.coords.LocalPoint;
+import org.lwjgl.BufferUtils;
+import static org.lwjgl.opengl.GL33C.*;
+
+/** Local renderer experiment. Never installed as a Hub or sideload plugin. */
+final class DepthLabelPass
+{
+    static final int MAX_LABELS = 64;
+    static final int MAX_TEXTURES = 128;
+    private int program, vao;
+    private int projectionUniform, viewportUniform, imageUniform, anchorUniform, sizeUniform;
+    private final BufferedImage raster = new BufferedImage(480, 22, BufferedImage.TYPE_INT_ARGB);
+    private final ByteBuffer upload = BufferUtils.createByteBuffer(480 * 22 * 4);
+    private static final Font LABEL_FONT = new Font(Font.SANS_SERIF, Font.BOLD, 12);
+
+    boolean hasLabels() { return !labels.isEmpty(); }
+
+    private final Map<String, Texture> textures = new LinkedHashMap<>(128, .75f, true);
+    private volatile List<Label> labels = Collections.emptyList();
+
+    static final class Label
+    {
+        final String text;
+        final float x, y, z;
+        final float[] ground;
+        Label(String text, float x, float y, float z)
+        {
+            this(text, x, y, z, null);
+        }
+        Label(String text, float x, float y, float z, float[] ground)
+        {
+            this.text = text; this.x = x; this.y = y; this.z = z;
+            this.ground = ground;
+        }
+    }
+
+    private static final class Texture
+    {
+        final int id, width, height;
+        Texture(int id, int width, int height)
+        {
+            this.id = id; this.width = width; this.height = height;
+        }
+    }
+
+    // Snapshot on the client thread. No game state is read by the GL draw pass.
+    void collect(Client client, int labelHeight, boolean automaticClearance)
+    {
+        labels = Collections.emptyList();
+        WorldView world = client.getTopLevelWorldView();
+        if (client.getGameState() != GameState.LOGGED_IN || world == null
+            || client.getLocalPlayer() == null
+            || client.getLocalPlayer().getWorldView() != world)
+        {
+            return;
+        }
+        LocalPoint player = client.getLocalPlayer().getLocalLocation();
+        Tile[][] tiles = world.getScene().getTiles()[world.getPlane()];
+        List<Label> next = new ArrayList<>();
+        int px = player.getSceneX(), py = player.getSceneY();
+        for (int x = Math.max(0, px - 12); x <= Math.min(tiles.length - 1, px + 12); x++)
+        {
+            for (int y = Math.max(0, py - 12); y <= Math.min(tiles[x].length - 1, py + 12); y++)
+            {
+                Tile tile = tiles[x][y];
+                if (tile == null || next.size() >= MAX_LABELS) { continue; }
+                List<TileItem> items = tile.getGroundItems();
+                if (items == null || items.isEmpty()) { continue; }
+                String name = client.getItemDefinition(items.get(0).getId()).getName();
+                if (items.size() > 1) { name += " +" + (items.size() - 1); }
+                LocalPoint point = tile.getLocalLocation();
+                // One billboard per pile above the sampled ground surface.
+                int height = Perspective.getTileHeight(client, point, world.getPlane())
+                    - Math.max(1, Math.min(150, labelHeight));
+                float[] ground = null;
+                if (automaticClearance)
+                {
+                    // A small patch within this item's tile, not neighboring hills or objects.
+                    ground = new float[27];
+                    int index = 0;
+                    for (int dx = -24; dx <= 24; dx += 24)
+                    {
+                        for (int dz = -24; dz <= 24; dz += 24)
+                        {
+                            LocalPoint sample = new LocalPoint(point.getX()+dx, point.getY()+dz, world);
+                            ground[index++] = sample.getX();
+                            ground[index++] = Perspective.getTileHeight(client, sample, world.getPlane());
+                            ground[index++] = sample.getY();
+                        }
+                    }
+                }
+                next.add(new Label("TEST: " + name, point.getX(), height, point.getY(), ground));
+            }
+        }
+        labels = Collections.unmodifiableList(next);
+    }
+
+    void render(float[] projection, int width, int height)
+    {
+        render(projection, width, height, labels);
+    }
+
+    void render(float[] projection, int width, int height, List<Label> commands)
+    {
+        if (commands.isEmpty() || width <= 0 || height <= 0) { return; }
+        // No FBO changes, clears, scene redraw, depth readback or depth writes.
+        try (State ignored = new State())
+        {
+            if (program == 0) { initialize(); }
+            glUseProgram(program);
+            glBindVertexArray(vao);
+            glActiveTexture(GL_TEXTURE0);
+            glBindBuffer(GL_PIXEL_UNPACK_BUFFER, 0);
+            glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+            glPixelStorei(GL_UNPACK_ROW_LENGTH, 0);
+            glPixelStorei(GL_UNPACK_SKIP_PIXELS, 0);
+            glPixelStorei(GL_UNPACK_SKIP_ROWS, 0);
+            glEnable(GL_DEPTH_TEST);
+            glDepthFunc(GL_GREATER); // RuneLite's reversed-Z projection.
+            glDepthMask(false);
+            glDisable(GL_CULL_FACE);
+            glEnable(GL_BLEND);
+            glBlendEquationSeparate(GL_FUNC_ADD, GL_FUNC_ADD);
+            glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+            glUniformMatrix4fv(projectionUniform, false, projection);
+            glUniform2f(viewportUniform, width, height);
+            glUniform1i(imageUniform, 0);
+            for (Label label : commands.subList(0, Math.min(MAX_LABELS, commands.size())))
+            {
+                Texture texture = texture(label.text);
+                glBindTexture(GL_TEXTURE_2D, texture.id);
+                float lift = GroundClearance.lift(projection, label.x, label.y, label.z,
+                    label.ground, height, texture.height);
+                glUniform3f(anchorUniform, label.x, label.y - lift, label.z);
+                glUniform2f(sizeUniform, texture.width, texture.height);
+                glDrawArrays(GL_TRIANGLES, 0, 6);
+            }
+        }
+    }
+
+    private void initialize()
+    {
+        int vertex = 0, fragment = 0, candidate = 0;
+        try
+        {
+            vertex = shader(GL_VERTEX_SHADER,
+                "#version 330\n"
+                + "uniform mat4 projection; uniform vec3 anchor; uniform vec2 viewport, size; out vec2 uv;\n"
+                + "const vec2 corners[6]=vec2[6](vec2(0,0),vec2(1,0),vec2(1,1),vec2(0,0),vec2(1,1),vec2(0,1));\n"
+                + "void main(){ uv=corners[gl_VertexID]; vec4 p=projection*vec4(anchor,1);"
+                + "p.xy+=(uv-vec2(.5))*vec2(1,-1)*size*2.0/viewport*p.w; gl_Position=p; }\n");
+            fragment = shader(GL_FRAGMENT_SHADER,
+                "#version 330\nuniform sampler2D image; in vec2 uv; out vec4 color;\n"
+                + "void main(){ color=texture(image,uv); if(color.a<0.01) discard; }\n");
+            candidate = glCreateProgram();
+            glAttachShader(candidate, vertex); glAttachShader(candidate, fragment);
+            glLinkProgram(candidate);
+            if (glGetProgrami(candidate, GL_LINK_STATUS) == GL_FALSE)
+            { throw new IllegalStateException(glGetProgramInfoLog(candidate)); }
+            vao = glGenVertexArrays();
+            program = candidate;
+            projectionUniform = glGetUniformLocation(program, "projection");
+            viewportUniform = glGetUniformLocation(program, "viewport");
+            imageUniform = glGetUniformLocation(program, "image");
+            anchorUniform = glGetUniformLocation(program, "anchor");
+            sizeUniform = glGetUniformLocation(program, "size");
+
+            candidate = 0;
+        }
+        finally
+        {
+            if (candidate != 0) { glDeleteProgram(candidate); }
+            if (vertex != 0) { glDeleteShader(vertex); }
+            if (fragment != 0) { glDeleteShader(fragment); }
+        }
+    }
+
+    private static int shader(int type, String source)
+    {
+        int shader = glCreateShader(type);
+        glShaderSource(shader, source); glCompileShader(shader);
+        if (glGetShaderi(shader, GL_COMPILE_STATUS) == GL_FALSE)
+        {
+            String error = glGetShaderInfoLog(shader);
+            glDeleteShader(shader);
+            throw new IllegalStateException(error);
+        }
+        return shader;
+    }
+
+    private Texture texture(String text)
+    {
+        // Bound both text size and GPU allocations even during repeated region changes.
+        String key = text.substring(0, Math.min(text.length(), 70));
+        Texture cached = textures.get(key);
+        if (cached != null) { return cached; }
+        BufferedImage image = raster;
+        Graphics2D graphics = image.createGraphics();
+        int width;
+        try
+        {
+            graphics.setFont(LABEL_FONT);
+            graphics.setComposite(java.awt.AlphaComposite.Src);
+            width = Math.min(480, graphics.getFontMetrics().stringWidth(key) + 12);
+            graphics.setColor(new Color(10, 15, 22, 220)); graphics.fillRect(0, 0, width, 22);
+            graphics.setColor(Color.CYAN); graphics.drawRect(0, 0, width - 1, 21);
+            graphics.drawString(key, 6, 16);
+        }
+        finally { graphics.dispose(); }
+        ByteBuffer bytes = upload; bytes.clear();
+        int[] pixels = ((java.awt.image.DataBufferInt)image.getRaster().getDataBuffer()).getData();
+        for (int y = 0; y < 22; y++)
+        {
+            for (int x = 0; x < width; x++)
+            {
+                int argb = pixels[y * 480 + x];
+                bytes.put((byte)(argb >> 16)).put((byte)(argb >> 8)).put((byte)argb).put((byte)(argb >> 24));
+            }
+        }
+        bytes.flip();
+        int id;
+        if (textures.size() >= MAX_TEXTURES)
+        {
+            String eldest = textures.keySet().iterator().next();
+            id = textures.remove(eldest).id;
+        }
+        else { id = glGenTextures(); }
+        glBindTexture(GL_TEXTURE_2D, id);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MIN_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_MAG_FILTER, GL_LINEAR);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_S, GL_CLAMP_TO_EDGE);
+        glTexParameteri(GL_TEXTURE_2D, GL_TEXTURE_WRAP_T, GL_CLAMP_TO_EDGE);
+        glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, width, 22, 0, GL_RGBA, GL_UNSIGNED_BYTE, bytes);
+        Texture result = new Texture(id, width, 22);
+        textures.put(key, result);
+        return result;
+    }
+
+    void close()
+    {
+        for (Texture texture : textures.values()) { glDeleteTextures(texture.id); }
+        textures.clear();
+        if (vao != 0) { glDeleteVertexArrays(vao); vao = 0; }
+        if (program != 0) { glDeleteProgram(program); program = 0; }
+        labels = Collections.emptyList();
+    }
+
+    /** Restore every GL state changed by this pass, including first-use texture upload. */
+    private static final class State implements AutoCloseable
+    {
+        final int program = glGetInteger(GL_CURRENT_PROGRAM), vao = glGetInteger(GL_VERTEX_ARRAY_BINDING);
+        final int active = glGetInteger(GL_ACTIVE_TEXTURE), unpack = glGetInteger(GL_PIXEL_UNPACK_BUFFER_BINDING);
+        final int alignment = glGetInteger(GL_UNPACK_ALIGNMENT), row = glGetInteger(GL_UNPACK_ROW_LENGTH);
+        final int skipX = glGetInteger(GL_UNPACK_SKIP_PIXELS), skipY = glGetInteger(GL_UNPACK_SKIP_ROWS);
+        final int depth = glGetInteger(GL_DEPTH_FUNC), srcRGB = glGetInteger(GL_BLEND_SRC_RGB);
+        final int dstRGB = glGetInteger(GL_BLEND_DST_RGB), srcA = glGetInteger(GL_BLEND_SRC_ALPHA);
+        final int dstA = glGetInteger(GL_BLEND_DST_ALPHA), eqRGB = glGetInteger(GL_BLEND_EQUATION_RGB);
+        final int eqA = glGetInteger(GL_BLEND_EQUATION_ALPHA);
+        final boolean depthTest = glIsEnabled(GL_DEPTH_TEST), cull = glIsEnabled(GL_CULL_FACE);
+        final boolean blend = glIsEnabled(GL_BLEND), write = glGetBoolean(GL_DEPTH_WRITEMASK);
+        final int texture;
+        State()
+        {
+            glActiveTexture(GL_TEXTURE0); texture = glGetInteger(GL_TEXTURE_BINDING_2D);
+        }
+        public void close()
+        {
+            glUseProgram(program); glBindVertexArray(vao);
+            glActiveTexture(GL_TEXTURE0); glBindTexture(GL_TEXTURE_2D, texture); glActiveTexture(active);
+            glBindBuffer(GL_PIXEL_UNPACK_BUFFER, unpack);
+            glPixelStorei(GL_UNPACK_ALIGNMENT, alignment); glPixelStorei(GL_UNPACK_ROW_LENGTH, row);
+            glPixelStorei(GL_UNPACK_SKIP_PIXELS, skipX); glPixelStorei(GL_UNPACK_SKIP_ROWS, skipY);
+            glDepthFunc(depth); glDepthMask(write);
+            glBlendEquationSeparate(eqRGB, eqA); glBlendFuncSeparate(srcRGB, dstRGB, srcA, dstA);
+            set(GL_DEPTH_TEST, depthTest); set(GL_CULL_FACE, cull); set(GL_BLEND, blend);
+        }
+        private static void set(int key, boolean value) { if (value) { glEnable(key); } else { glDisable(key); } }
+    }
+}
