+package net.runelite.client.plugins.gpu;
+
+import java.util.HashMap;
+import java.util.HashSet;
+import java.util.Locale;
+import java.util.Map;
+import java.util.Set;
+import java.util.regex.Pattern;
+import net.runelite.api.Client;
+import net.runelite.api.ObjectComposition;
+import net.runelite.api.Tile;
+import net.runelite.api.TileObject;
+import net.runelite.api.WorldView;
+
+/** Classification is client-thread-owned. Render workers store IDs, never query definitions. */
+final class LabelOccluders
+{
+    static final int TERRAIN = -1, PLAYER = -2, IGNORE = -3;
+    static final LabelOccluders INSTANCE = new LabelOccluders();
+    private static final Pattern PROPS = Pattern.compile("\\b(chest|chests|crate|crates|barrel|barrels|chair|chairs|stool|stools|table|tables|bench|benches|cupboard|wardrobe|bookcase|drawers|sack|sacks|coffer)\\b");
+    private final Map<Integer, Boolean> known = new HashMap<>();
+    private Set<Integer> landscape = new HashSet<>(), props = new HashSet<>();
+    private String previousLandscape = "", previousProps = "";
+    private long nextScan;
+
+    static Set<Integer> parseIds(String text)
+    {
+        Set<Integer> result = new HashSet<>();
+        for (String value : text.trim().split("[,\\s]+"))
+        {
+            if (value.isEmpty()) { continue; }
+            try { int id = Integer.parseInt(value); if (id >= 0) { result.add(id); } }
+            catch (NumberFormatException ignored) { /* Invalid tokens never turn objects into props. */ }
+        }
+        return result;
+    }
+
+    static boolean defaultBlocks(String name)
+    {
+        return name == null || !PROPS.matcher(name.toLowerCase(Locale.ROOT)).find();
+    }
+
+    boolean blocks(int id)
+    {
+        if (id == TERRAIN || id == PLAYER) { return true; }
+        if (id == IGNORE) { return false; }
+        if (landscape.contains(id)) { return true; } // Blocking wins conflicting overrides.
+        if (props.contains(id)) { return false; }
+        return known.getOrDefault(id, true);
+    }
+
+    void configure(String landscapeIds, String propIds)
+    {
+        if (!landscapeIds.equals(previousLandscape) || !propIds.equals(previousProps))
+        {
+            landscape = parseIds(landscapeIds); props = parseIds(propIds);
+            previousLandscape = landscapeIds; previousProps = propIds;
+        }
+    }
+
+    void resolve(Client client, int id)
+    {
+        if (id < 0) { return; }
+        ObjectComposition definition = client.getObjectDefinition(id);
+        if (definition == null) { return; }
+        if (definition.getImpostorIds() != null) { definition = definition.getImpostor(); }
+        known.put(id, definition == null || defaultBlocks(definition.getName()));
+    }
+
+    void refresh(Client client, GpuPluginConfig config)
+    {
+        configure(config.testLandscapeIds(), config.testPropIds());
+        long now = System.nanoTime();
+        if (now < nextScan) { return; }
+        nextScan = now + 500_000_000L;
+        WorldView world = client.getTopLevelWorldView();
+        if (world == null) { known.clear(); return; }
+        // Resolve scene IDs on the client thread. Revisit transformations (e.g. open chests).
+        Set<Integer> seen = new HashSet<>();
+        for (Tile[][] plane : world.getScene().getExtendedTiles())
+        {
+            for (Tile[] row : plane)
+            {
+                for (Tile tile : row)
+                {
+                    if (tile == null) { continue; }
+                    visit(client, tile.getWallObject(), seen);
+                    visit(client, tile.getDecorativeObject(), seen);
+                    visit(client, tile.getGroundObject(), seen);
+                    for (TileObject object : tile.getGameObjects()) { visit(client, object, seen); }
+                }
+            }
+        }
+        known.keySet().retainAll(seen);
+    }
+
+    private void visit(Client client, TileObject object, Set<Integer> seen)
+    {
+        if (object != null && seen.add(object.getId())) { resolve(client, object.getId()); }
+    }
+}
